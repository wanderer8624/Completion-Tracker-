@model List<Game>
@{ViewData["Title"]="Intel Board";var s=((int total,int playing,int completed,int backlog,int hours,double avgRating))ViewBag.Stats;var logged=(bool)ViewBag.IsLoggedIn;}
<section class="hero"><div class="hero-image"></div><div class="hero-content"><div class="eyebrow"><span class="live-dot"></span> SYSTEM ONLINE <span class="slash">/</span> PERSONAL ARCHIVE 01</div><h1>EVERY GAME.<br><em>ONE MISSION.</em></h1><p>Your backlog is the objective. Your progress is the intel. Track every title from first deployment to final credits.</p><div class="hero-actions"><a class="btn btn-lime" asp-controller="Games" asp-action="Create">＋ ADD TO MISSION LOG</a><a class="btn btn-ghost" href="#archive">VIEW ARCHIVE <span>↘</span></a></div><div class="hero-foot"><span>01 — TRACK YOUR RUN</span><span>02 — RECORD YOUR HOURS</span><span>03 — COMPLETE THE OBJECTIVE</span></div></div><div class="hero-stamp">FIELD<br>REPORT<br><b>GV-01</b></div></section>
<section class="stats-grid"><div class="stat"><span class="stat-label">TOTAL IN ARCHIVE</span><strong>@s.total.ToString("00")</strong><span class="stat-foot">TITLES TRACKED</span></div><div class="stat"><span class="stat-label">ACTIVE MISSIONS</span><strong>@s.playing.ToString("00")</strong><span class="stat-foot"><i class="dot dot-green"></i> CURRENTLY PLAYING</span></div><div class="stat"><span class="stat-label">OBJECTIVES CLEARED</span><strong>@s.completed.ToString("00")</strong><span class="stat-foot">COMPLETED GAMES</span></div><div class="stat"><span class="stat-label">TIME IN THE FIELD</span><strong>@s.hours.ToString("00")<small>H</small></strong><span class="stat-foot">HOURS PLAYED</span></div><div class="stat stat-rating"><span class="stat-label">AVG. RATING</span><strong>@s.avgRating.ToString("0.0")<small>/10</small></strong><span class="stat-foot">YOUR SCORE</span></div></section>
<section id="archive" class="archive-section"><div class="section-heading"><div><div class="eyebrow">// DATABASE ACCESS: GRANTED</div><h2>MISSION <em>ARCHIVE</em></h2></div><span class="record-count">RECORDS FOUND: @Model.Count.ToString("00")</span></div><form class="filters" method="get" asp-controller="Home" asp-action="Index"><label class="searchbox"><span>⌕</span><input type="search" name="q" value="@ViewBag.Query" placeholder="Search title, operation, codename..." /></label><select name="status"><option value="">ALL STATUS</option>@foreach(var st in new[]{"Backlog","Playing","Completed","Dropped"}){<option value="@st" selected="@(ViewBag.Status as string==st)">@st.ToUpperInvariant()</option>}</select><select name="genre"><option value="">ALL GENRES</option>@foreach(var g in Model.Select(x=>x.Genre).Distinct().OrderBy(x=>x)){<option value="@g" selected="@(ViewBag.Genre as string==g)">@g.ToUpperInvariant()</option>}</select><button class="btn btn-outline btn-small" type="submit">FILTER ↗</button><a class="reset-link" asp-controller="Home" asp-action="Index">RESET</a></form>
@if(TempData["Toast"] is string toast){<div class="toast">✓ @toast</div>}
<div class="game-grid">@foreach(var game in Model){<article class="game-card"><div class="cover-wrap"><img class="game-cover" src="@game.CoverUrl" alt="@game.Title cover art" loading="lazy"/><span class="status status-@game.Status.ToLowerInvariant()">@game.Status.ToUpperInvariant()</span><span class="cover-index">GV-@game.Id.ToString("000")</span></div><div class="game-info"><div class="game-meta"><span>@game.Genre.ToUpperInvariant()</span><span>@game.Platform.ToUpperInvariant()</span></div><h3>@game.Title</h3><div class="game-progress"><div><span>FIELD TIME</span><b>@game.HoursPlayed H</b></div><div><span>RATING</span><b>@(game.Rating.HasValue ? game.Rating.Value.ToString()+" / 10" : "— / 10")</b></div></div>@if(!string.IsNullOrWhiteSpace(game.Notes)){<p class="game-notes">@game.Notes</p>}<div class="card-actions">@if(logged && game.OwnerEmail==Context.Session.GetString("Email")){<a asp-controller="Games" asp-action="Edit" asp-route-id="@game.Id">EDIT RECORD ↗</a><form asp-controller="Games" asp-action="Delete" asp-route-id="@game.Id" method="post" onsubmit="return confirm('Remove this game from your archive?')"><button type="submit">DELETE</button></form>}else{<span class="sample-record">@(game.OwnerEmail==null?"SAMPLE INTEL":"ARCHIVED")</span>}</div></div></article>}</div>
@if(Model.Count==0){<div class="empty-state"><div class="empty-symbol">⌕</div><h3>NO RECORDS MATCH YOUR SEARCH</h3><p>Adjust your filters or add a new title to the mission log.</p><a class="btn btn-lime" asp-controller="Games" asp-action="Create">ADD A GAME</a></div>}
</section><section class="bottom-callout"><div><span class="eyebrow">// OPERATOR NOTE</span><h2>THE BACKLOG WON'T<br><em>CLEAR ITSELF.</em></h2></div><p>Log the games you play. Track the hours you invest. Give every unfinished story a place in the archive.</p><a class="btn btn-lime" asp-controller="Games" asp-action="Create">LOG YOUR NEXT MISSION ↗</a></section>
