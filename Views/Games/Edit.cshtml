@model GameFormViewModel
@{ViewData["Title"]="Edit Record";}
<section class="editor-page"><div class="section-heading"><div><div class="eyebrow">// ARCHIVE MAINTENANCE</div><h2>EDIT <em>RECORD</em></h2></div><a class="reset-link" asp-controller="Home" asp-action="Index">← BACK TO ARCHIVE</a></div><div class="editor-layout"><div class="editor-art"><div class="editor-art-bg"></div><span class="eyebrow">RECORD ID / GV-@Model.Id.ToString("000")</span><h3>UPDATE<br>YOUR INTEL.</h3><p>Keep your record accurate as your playthrough evolves.</p></div><div class="editor-form"><form method="post" asp-action="Edit"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="validation"></div><label>GAME TITLE *<input asp-for="Title"/><span asp-validation-for="Title"></span></label><div class="form-row"><label>GENRE<select asp-for="Genre"><option>Action</option><option>Action Adventure</option><option>Adventure</option><option>RPG</option><option>Soulslike</option><option>FPS</option><option>Strategy</option><option>Roguelike</option><option>Puzzle</option><option>Horror</option><option>Simulation</option><option>Racing</option><option>Sports</option><option>Indie</option><option>Other</option></select></label><label>PLATFORM<select asp-for="Platform"><option>PC</option><option>PlayStation 5</option><option>PlayStation 4</option><option>Xbox Series X/S</option><option>Xbox One</option><option>Nintendo Switch</option><option>Mobile</option><option>Other</option></select></label></div><div class="form-row"><label>STATUS<select asp-for="Status"><option>Backlog</option><option>Playing</option><option>Completed</option><option>Dropped</option></select></label><label>HOURS PLAYED<input asp-for="HoursPlayed" type="number" min="0" max="10000"/></label></div><div class="form-row"><label>YOUR RATING (0–10)<input asp-for="Rating" type="number" min="0" max="10"/></label><label>COVER IMAGE URL<input asp-for="CoverUrl"/><span asp-validation-for="CoverUrl"></span></label></div><label>FIELD NOTES<textarea asp-for="Notes" rows="3"></textarea><span asp-validation-for="Notes"></span></label><button class="btn btn-lime btn-full" type="submit">UPDATE ARCHIVE RECORD ↗</button></form></div></div></section>
