@model GameFormViewModel
@{ViewData["Title"]="Log a Game";}
<section class="editor-page"><div class="section-heading"><div><div class="eyebrow">// NEW ARCHIVE ENTRY</div><h2>LOG A <em>MISSION</em></h2></div><a class="reset-link" asp-controller="Home" asp-action="Index">← BACK TO ARCHIVE</a></div><div class="editor-layout"><div class="editor-art"><div class="editor-art-bg"></div><span class="eyebrow">FIELD RECORD / NEW</span><h3>EVERY RUN<br>COUNTS.</h3><p>Record the details. Track your progress. Make the completion count.</p><div class="editor-coordinates">GRID 34.0522° N<br>ARCHIVE NODE // GV</div></div><div class="editor-form"><form method="post" asp-action="Create"><div asp-validation-summary="ModelOnly" class="validation"></div><label>GAME TITLE *<input asp-for="Title" placeholder="Enter game title"/><span asp-validation-for="Title"></span></label><div class="form-row"><label>GENRE<select asp-for="Genre"><option>Action</option><option>Action Adventure</option><option>Adventure</option><option>RPG</option><option>Soulslike</option><option>FPS</option><option>Strategy</option><option>Roguelike</option><option>Puzzle</option><option>Horror</option><option>Simulation</option><option>Racing</option><option>Sports</option><option>Indie</option><option>Other</option></select></label><label>PLATFORM<select asp-for="Platform"><option>PC</option><option>PlayStation 5</option><option>PlayStation 4</option><option>Xbox Series X/S</option><option>Xbox One</option><option>Nintendo Switch</option><option>Mobile</option><option>Other</option></select></label></div><div class="form-row"><label>STATUS<select asp-for="Status"><option>Backlog</option><option>Playing</option><option>Completed</option><option>Dropped</option></select></label><label>HOURS PLAYED<input asp-for="HoursPlayed" type="number" min="0" max="10000"/></label></div><div class="form-row"><label>YOUR RATING (0–10)<input asp-for="Rating" type="number" min="0" max="10" placeholder="Leave blank if unrated"/></label><label>COVER IMAGE URL<input asp-for="CoverUrl" placeholder="https://... (optional)"/><span asp-validation-for="CoverUrl"></span></label></div><label>FIELD NOTES <span class="optional">OPTIONAL</span><textarea asp-for="Notes" rows="3" placeholder="Your thoughts, next objective, memorable moments..."></textarea><span asp-validation-for="Notes"></span></label><button class="btn btn-lime btn-full" type="submit">SAVE TO MISSION ARCHIVE ↗</button></form></div></div></section>
