<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · MISSION LOG</title><meta name="theme-color" content="#101511"/><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><div class="scanline"></div><header class="topbar"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">G<span>V</span></span><span>GAME<span class="brand-muted">VAULT</span><small>PERSONAL MISSION LOG</small></span></a><nav><a asp-controller="Home" asp-action="Index">INTEL BOARD</a><a asp-controller="Home" asp-action="Index" asp-route-status="Playing">IN PROGRESS</a><a asp-controller="Home" asp-action="Index" asp-route-status="Completed">COMPLETED</a></nav><div class="nav-right">@if(Context.Session.GetString("Email") is string email){<span class="operator">OPERATOR / @Context.Session.GetString("Name")?.ToUpperInvariant()</span><a class="btn btn-outline btn-small" asp-controller="Games" asp-action="Create">+ LOG GAME</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="text-button">EXIT</button></form>}else{<a class="text-button" asp-controller="Account" asp-action="Login">SIGN IN</a><a class="btn btn-lime btn-small" asp-controller="Account" asp-action="Register">JOIN THE UNIT</a>}</div></header><main>@RenderBody()</main><footer><span>GAMEVAULT // PERSONAL GAME COMPLETION TRACKER</span><span>KEEP YOUR RECORD. FINISH THE MISSION.</span></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
