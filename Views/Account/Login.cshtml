@model LoginViewModel
@{ViewData["Title"]="Operator Sign In";}
<section class="form-page"><div class="form-art login-art"><div class="eyebrow"><span class="live-dot"></span> SECURE CHANNEL</div><h1>WELCOME<br><em>BACK, OPERATOR.</em></h1><p>Your archive is waiting. Pick up where you left off.</p><div class="form-art-code">AUTHENTICATION // REQUIRED<br>ACCESS LEVEL: OPERATOR<br>STATUS: READY</div></div><div class="form-panel"><div class="eyebrow">IDENTITY CHECK</div><h2>OPERATOR <em>LOGIN</em></h2><p class="muted">Enter your credentials to access your records.</p><form method="post" asp-action="Login"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="validation"></div><label>EMAIL ADDRESS<input asp-for="Email" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email"></span></label><label>PASSWORD<input asp-for="Password" placeholder="Your password" autocomplete="current-password"/><span asp-validation-for="Password"></span></label><button class="btn btn-lime btn-full" type="submit">AUTHENTICATE ↗</button></form><p class="form-switch">New here? <a asp-action="Register">Create an operator profile</a></p></div></section>
