@model RegisterViewModel
@{ViewData["Title"]="Join the Unit";}
<section class="form-page"><div class="form-art"><div class="eyebrow"><span class="live-dot"></span> ENLISTMENT PROTOCOL</div><h1>YOUR STORY.<br><em>YOUR RECORD.</em></h1><p>Create an operator profile to maintain your own private game archive.</p><div class="form-art-code">SECURE CHANNEL // GV-001<br>ENCRYPTION: ENABLED<br>STATUS: AWAITING OPERATOR</div></div><div class="form-panel"><div class="eyebrow">NEW OPERATOR</div><h2>JOIN THE <em>UNIT</em></h2><p class="muted">Create your account to start tracking.</p><form method="post" asp-action="Register"><div asp-validation-summary="ModelOnly" class="validation"></div><label>OPERATOR NAME<input asp-for="Name" placeholder="Your display name" autocomplete="name"/><span asp-validation-for="Name"></span></label><label>EMAIL ADDRESS<input asp-for="Email" placeholder="you@example.com" autocomplete="email"/><span asp-validation-for="Email"></span></label><label>PASSWORD<input asp-for="Password" placeholder="At least 8 characters" autocomplete="new-password"/><span asp-validation-for="Password"></span></label><label>CONFIRM PASSWORD<input asp-for="ConfirmPassword" placeholder="Repeat password" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword"></span></label><button class="btn btn-lime btn-full" type="submit">CREATE OPERATOR PROFILE ↗</button></form><p class="form-switch">Already registered? <a asp-action="Login">Sign in</a></p></div></section>
@section Scripts{<partial name="_ValidationScriptsPartial" />}
